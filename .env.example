# Terminal Agent Runtime — 智能终端 Agent Runtime 环境变量示例（无真实密钥）
# 复制为 .env 后填写；.env 已被 gitignore，勿提交。
# 默认对接阶跃星辰 Step OpenAI 兼容接口（https://api.stepfun.com/v1）。

# fake | openai_compatible
DEVICE_AGENT_MODEL_MODE=openai_compatible

# 阶跃星辰 Step（OpenAI-compatible）
DEVICE_AGENT_MODEL_BASE_URL=https://api.stepfun.com/v1
DEVICE_AGENT_MODEL_API_KEY=
DEVICE_AGENT_MODEL_ID=step-3.5-flash
# 默认 Step 3.5 Flash：公开模型，工具调用 / Agent 比较稳。也可换成 MiniCPM 或 step-3.7-flash
# 端侧模型占位（与云端共用协议，实现可不同）
DEVICE_AGENT_MODEL_EDGE_ID=step-edge-stub
# cloud | edge — edge 时 Harness 返回 EDGE_UNAVAILABLE，不冒充离线 Agent
DEVICE_AGENT_MODEL_PLACEMENT=cloud

DEVICE_AGENT_EVENT_LOG_DIR=./data/events
DEVICE_AGENT_PERSISTENCE=sqlite
DEVICE_AGENT_SQLITE_PATH=./data/harness.db
DEVICE_AGENT_REQUIRE_CONFIRMATION=false

# Phase-1 platform (optional). Empty HTTP key = local demo stays open.
# DEVICE_AGENT_HTTP_API_KEY=
# DEVICE_AGENT_TENANT_ID=local
# DEVICE_AGENT_EXECUTION_ENVIRONMENT=sim
# DEVICE_AGENT_MAX_CONCURRENT_RUNS=8
# DEVICE_AGENT_MAX_RUNS_PER_MINUTE=0
# DEVICE_AGENT_CIRCUIT_BREAKER_FAILURES=0
# DEVICE_AGENT_AUDIT_LOG_DIR=./data/audit
# DEVICE_AGENT_DENY_WRITES=false
# DEVICE_AGENT_HIGH_RISK_CAPABILITIES=
# DEVICE_AGENT_WORK_HOURS_START=
# DEVICE_AGENT_WORK_HOURS_END=
